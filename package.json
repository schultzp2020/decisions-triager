{
  "name": "decisions-triager",
  "version": "1.0.0",
  "description": "Guarded Jira auto-triage: decision-model classification (llama.cpp / OpenAI) with fail-closed writes",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schultzp2020/decisions-triager.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "lint": "oxlint --deny-warnings --type-aware --type-check",
    "lint:fix": "oxlint --fix --deny-warnings --type-aware --type-check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "cleye": "^2.7.0",
    "jira.js": "^6.3.0",
    "typebox": "^1.3.27",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "vitest": "^5.0.5"
  }
}
